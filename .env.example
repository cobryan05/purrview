# PurrView deployment config. Copy to `.env` and edit, or run ./setup.sh.
# docker compose reads .env automatically.

# --- Which containers run (deployment topology) ---
# app            frontend + inference group
# training       standalone training node (GPU)
# app,training   split: frontend group + local training container
# mono           everything in one container (GPU)
# dev            app-dev + training-dev workspaces
# dev-mono       single-container dev workspace
COMPOSE_PROFILES=app

# --- App image build knobs ---
# slim-runtime  -> CPU-only, no CUDA (smallest). Pair with requirements-cpu.txt.
# cuda-runtime  -> GPU inference (onnxruntime-gpu, no torch). Pair with requirements-gpu.txt.
APP_BASE=slim-runtime
ORT_REQUIREMENTS=requirements-cpu.txt

# Give the `app` container a GPU for onnxruntime-gpu inference. Only set this
# (and use cuda-runtime + requirements-gpu.txt above) on a host with a GPU.
# COMPOSE_FILE=docker-compose.yaml:docker-compose.gpu.yaml

# Which GPUs the containers may use, as a CUDA_VISIBLE_DEVICES index list
# ("0", "0,1", …) — `nvidia-smi -L` on the host numbers them. A GPU left out
# here is invisible to both torch and onnxruntime, so a card reserved for
# something else stays reserved.
#
# NEVER set this to an empty string. Unset means "all GPUs" to CUDA, but empty
# means "no GPUs" and presents as a container that lost its GPU.
# GPU_DEVICES=0

# How Docker attaches the GPU. Default is the legacy NVIDIA runtime hook
# (nvidia / all). Hosts whose NVIDIA Container Toolkit uses CDI need:
#   GPU_DRIVER=cdi
#   GPU_DEVICE_ID=nvidia.com/gpu=all
# ./setup.sh probes both and writes these when CDI works.
# GPU_DRIVER=nvidia
# GPU_DEVICE_ID=all

# Which of the exposed cards each service uses by default.
#
# These are CUDA *ordinals* — a position within GPU_DEVICES — NOT physical card
# ids. CUDA_VISIBLE_DEVICES renumbers from zero, so with GPU_DEVICES=1 the host's
# second card is ordinal 0 and INFERENCE_GPU=1 would name a device that does not
# exist. ./setup.sh asks in physical ids and writes the ordinal for you; set these
# by hand only if you are confident which is which.
#
# Leave unset for "let onnxruntime/torch choose", which is exactly how these
# services behaved before the settings existed. Unset is not the same as 0.
#
# Both are only defaults, and both can be overridden per unit of work:
#   * a model's sidecar `device` (auto | gpu | cpu | gpu:<n>) beats INFERENCE_GPU
#   * a training job's own `gpu_device` beats TRAINING_GPU
# INFERENCE_GPU=0
# TRAINING_GPU=1

# --- Wiring ---
# Hostname and port the frontend uses to reach the training node. Defaults to
# the `training` compose service on its container port; set both to a remote
# host and the port THAT host publishes (its TRAINING_PORT) for a remote GPU
# trainer. A local `training` service is always dialled on 8005 regardless of
# what this host publishes it as.
# TRAINING_SERVER_HOST=training
# TRAINING_SERVER_PORT=8005

# Whether training on this host is meant to have a GPU. Written by ./setup.sh,
# which sets 0 only where you answered "continue anyway" to its no-GPU warning.
# The training server raises a standing notice in the app when a job falls back
# to the CPU and this is not 0 — an absent value counts as 1, so a deployment
# that has never seen this variable still gets warned.
# TRAINING_EXPECTS_GPU=1

# --- Container user (match host uid/gid for clean bind-mount ownership) ---
APPUSER_UID=1000
APPUSER_GID=1000

# --- Host ports ---
# Where each service is published on this host. Host-side mappings only: inside
# the containers the app is always 7999, the training API 8005, supervisord 9001
# and the RTSP relay 8554, so the service config never changes.
#   APP_PORT / SUPERVISORD_PORT / RTSP_PORT   app, app-dev, mono, mono-dev
#   TRAINING_PORT                     training, training-dev, mono, mono-dev
#   TRAINING_SUPERVISORD_PORT         training, training-dev (their own dashboard)
# APP_PORT=7999
# SUPERVISORD_PORT=9001
# RTSP_PORT=8553
# TRAINING_PORT=8005
# TRAINING_SUPERVISORD_PORT=9002

# --- Sizing: RAM ---
# In-RAM rolling buffer (tmpfs /buffer) that MediaMTX records into, giving the
# stream watcher its rewind window. This is a cap, not an allocation — an empty
# buffer costs ~0 RAM. Budget ~30 MB per camera per 60 s of rewind at 4 Mbps,
# so the 512m default holds roughly 17 camera-minutes.
# Applies to the containers that run mediamtx: app, app-dev, mono, mono-dev.
# STREAM_BUFFER_SIZE=512m

# Shared-memory budget for the PyTorch DataLoader in the training containers
# (training, training-dev, mono, mono-dev). Too small a value surfaces as a
# confusing disk-full-looking crash rather than an obvious OOM.
# TRAINING_SHM_SIZE=2gb

# --- Sizing: disk caches ---
# Thumbnail cache cap in MB (app, app-dev, mono, mono-dev).
# NOTE: 0 means *unbounded*, not "no cache".
# THUMB_CACHE_MAX_MB=100

# Training image cache (training, training-dev, mono, mono-dev): size cap in MB,
# age-based eviction in days, and how often the sweeper runs in seconds.
# TRAINING_CACHE_MAX_MB=10000
# TRAINING_CACHE_MAX_AGE_DAYS=30
# TRAINING_CACHE_SWEEP_INTERVAL_SEC=3600

# --- Recording storage (NVR clips, event snapshots, event timelapses) ---
# All three are written under /data/recordings/ inside the container, which is
# the ./data bind mount. To put recordings on another disk, move that whole
# mount (e.g. `- /mnt/nas/purrview:/data` in docker-compose.override.yml).
# Everything beneath it belongs to the app, so this is always safe.
#
#   !! NEVER point a recordings root at a directory that holds anything else. !!
#
# Space is reclaimed two different ways, and only one of them is provably safe:
#
#   * Deleting a recording's own file is driven by its database row, so it only
#     ever removes files this app created. Safe anywhere on disk.
#   * The ORPHAN SWEEP walks the recordings roots and deletes every file that no
#     database row points at, once it is older than RECORDINGS_ORPHAN_GRACE_S
#     (default 900 s / 15 min). It only deletes the suffixes this app itself
#     writes (.mp4, .jpg, .json and the .part/.repair/.txt/.png scratch beside
#     them), so a document or an archive under a root is left alone — but .jpg
#     and .mp4 are exactly what a photo or video library is made of, and it
#     cannot tell yours from ours. Mount a shared media folder at a recordings
#     root and the sweep will empty it of media. Its only real safety argument
#     is that those directories belong to the app alone.
#
# This is why RECORDINGS_CLIP_DIR / RECORDINGS_SNAPSHOT_DIR /
# RECORDINGS_TIMELAPSE_DIR are deliberately NOT wired through .env: the safe
# knob (relocate all of ./data) is exposed, the dangerous one is not. If you
# genuinely need to move a single root, add it to that service's `environment:`
# in docker-compose.override.yml and give it a directory of its very own.
#
# The same rule covers the "Event timelapse" watcher action's `output_dir`. Left
# at its default the video is a recording attached to its event, bounded by the
# Settings -> Recording retention. An absolute path still gets counted and still
# gets deleted with its event — so there is no reason to repoint a root to
# regain retention, which is the mistake this note exists to prevent.

# --- Local time ---
# Every container bind-mounts the host's /etc/localtime and /etc/timezone
# read-only, so local time (log timestamps, event times) follows the host with
# no configuration, and there is nothing to set here. To deliberately run the
# stack in a zone other than the host's, add `TZ: <zone>` to the service's
# `environment:` in docker-compose.override.yml — a TZ env var wins over the
# mounted zone files.
