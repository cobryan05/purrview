{
  "compilerOptions": {
    "module": "esnext",
    "lib": [
      "dom",
      "esnext"
    ],
    "target": "ES2015",
    "checkJs": true,
    "strict": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "/app-static/*": [
        "./static/*"
      ],
      "@konva": [
        "/app/static/js/konva-types/index-types.d.ts"
      ],
      "@web_api": [
        "/app/static/js/api-types/models/index.ts"
      ],
      "@app_types": [
        "./static/js/types.js"
      ],
      "@ui_types": [
        "./static/js/ui/types.js"
      ],
      "@canvas_types": [
        "./static/js/app/image-tagging/canvas/types.js"
      ],
      "@image_tagging_types": [
        "./static/js/app/image-tagging/types.js"
      ],
      "@events": [
        "./static/js/shared/events/types.js"
      ],
      "@konva_groups": [
        "./static/js/canvas/groups/index.js"
      ]
    }
  },
  "include": [
    "**/*.js",
    "**/*.ts",
    "konva-globals.d.ts"
  ],
}