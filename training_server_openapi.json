{
  "openapi": "3.1.0",
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "paths": {
    "/api/training/jobs": {
      "get": {
        "tags": [
          "training"
        ],
        "summary": "List Jobs",
        "operationId": "list_training_jobs",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListJobsResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "training"
        ],
        "summary": "Submit Job",
        "operationId": "submit_training_job",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitJobPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/training/jobs/{job_id}": {
      "get": {
        "tags": [
          "training"
        ],
        "summary": "Get Job",
        "operationId": "get_training_job",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobInfo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "training"
        ],
        "summary": "Cancel Job",
        "operationId": "cancel_training_job",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/training/jobs/{job_id}/missing-images": {
      "get": {
        "tags": [
          "training"
        ],
        "summary": "Get Missing Images",
        "description": "Return image UUIDs from the job's manifest that are not yet cached.",
        "operationId": "get_missing_images",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MissingImagesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/training/jobs/{job_id}/images": {
      "post": {
        "tags": [
          "training"
        ],
        "summary": "Ingest Images",
        "description": "Accept a tar stream of images and extract them into the cache.",
        "operationId": "ingest_images",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestImagesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/training/jobs/{job_id}/start": {
      "post": {
        "tags": [
          "training"
        ],
        "summary": "Start Job",
        "description": "Validate data completeness and transition job to 'queued'.",
        "operationId": "start_training_job",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/training/jobs/{job_id}/artifact": {
      "get": {
        "tags": [
          "training"
        ],
        "summary": "Get Artifact",
        "description": "Stream a tar of the trained model artifacts (ONNX + JSON).\n\nReturns 404 until the job is in 'done' status.",
        "operationId": "get_training_artifact",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/training/jobs/{job_id}/stream": {
      "get": {
        "tags": [
          "training"
        ],
        "summary": "Stream Job",
        "description": "SSE stream of progress events for a training job.\n\nReplays all past events on connect so clients can reconnect mid-job\nand still receive the full history. Closes automatically when the\njob reaches a terminal state (done / error / cancelled).",
        "operationId": "stream_training_job",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/server-config": {
      "get": {
        "summary": "Server Config",
        "operationId": "server_config",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/training/status": {
      "get": {
        "summary": "Training Status",
        "operationId": "training_status",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CancelJobResponse": {
        "properties": {
          "cancelled": {
            "type": "boolean",
            "title": "Cancelled"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "cancelled",
          "message"
        ],
        "title": "CancelJobResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestImagesResponse": {
        "properties": {
          "received": {
            "type": "integer",
            "title": "Received"
          },
          "cached_total": {
            "type": "integer",
            "title": "Cached Total"
          }
        },
        "type": "object",
        "required": [
          "received",
          "cached_total"
        ],
        "title": "IngestImagesResponse"
      },
      "JobInfo": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "trainer_type": {
            "type": "string",
            "title": "Trainer Type"
          },
          "model_name": {
            "type": "string",
            "title": "Model Name"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "queue_position": {
            "type": "integer",
            "title": "Queue Position"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "trainer_type",
          "model_name",
          "created_at",
          "queue_position"
        ],
        "title": "JobInfo"
      },
      "ListJobsResponse": {
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/JobInfo"
            },
            "type": "array",
            "title": "Jobs"
          }
        },
        "type": "object",
        "required": [
          "jobs"
        ],
        "title": "ListJobsResponse"
      },
      "ManifestEntry": {
        "properties": {
          "image_uuid": {
            "type": "string",
            "title": "Image Uuid"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "image_uuid",
          "filename",
          "status"
        ],
        "title": "ManifestEntry"
      },
      "MissingImagesResponse": {
        "properties": {
          "uuids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Uuids"
          }
        },
        "type": "object",
        "required": [
          "uuids"
        ],
        "title": "MissingImagesResponse"
      },
      "StartJobResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "missing": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "StartJobResponse"
      },
      "SubmitJobPayload": {
        "properties": {
          "trainer_type": {
            "type": "string",
            "title": "Trainer Type"
          },
          "label_uuid": {
            "type": "string",
            "title": "Label Uuid",
            "default": ""
          },
          "model_name": {
            "type": "string",
            "title": "Model Name",
            "default": ""
          },
          "architecture": {
            "type": "string",
            "title": "Architecture",
            "default": ""
          },
          "class_names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Class Names"
          },
          "hyperparams": {
            "additionalProperties": true,
            "type": "object",
            "title": "Hyperparams"
          },
          "max_epochs": {
            "type": "integer",
            "title": "Max Epochs",
            "default": 50
          },
          "batch_size": {
            "type": "integer",
            "title": "Batch Size",
            "default": 32
          },
          "early_stopping_patience": {
            "type": "integer",
            "title": "Early Stopping Patience",
            "default": 10
          },
          "manifest": {
            "items": {
              "$ref": "#/components/schemas/ManifestEntry"
            },
            "type": "array",
            "title": "Manifest"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "trainer_type"
        ],
        "title": "SubmitJobPayload",
        "description": "Payload for POST /api/training/jobs.\n\n``trainer_type`` is required; all other fields are optional.\nExtra fields are forwarded to the trainer config."
      },
      "SubmitJobResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "queue_position": {
            "type": "integer",
            "title": "Queue Position"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "queue_position"
        ],
        "title": "SubmitJobResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}