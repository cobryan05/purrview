#!/bin/sh
# Block commits containing unformatted Python.
#
# Checks the *staged* content of each staged .py file, not the working tree, so
# concurrent in-flight edits by another process cannot fail your commit and a
# partially-staged file is judged on what you are actually committing.
#
# black/isort are pinned in requirements-dev.txt and only exist inside the app
# container, so the check runs there. If the container is not up, the hook warns
# and passes rather than blocking work.
#
# Install with ./scripts/install-git-hooks.sh

CONTAINER="${ENCOUNTERWATCH_CONTAINER:-encounterwatch_mono_dev}"

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
config=$(git diff --cached --name-only --diff-filter=ACMR -- pyproject.toml requirements-dev.txt)

[ -z "$files" ] && [ -z "$config" ] && exit 0

# Word-splitting below can't survive spaces in paths; none exist in this repo,
# but skip rather than mangle the list if that ever changes.
case "$files" in
*" "*)
    printf '%s\n' "pre-commit: path with a space in the staged set — skipping format check" >&2
    exit 0
    ;;
esac

if ! docker exec "$CONTAINER" true >/dev/null 2>&1; then
    printf '%s\n' "pre-commit: container '$CONTAINER' is not running — skipping format check" >&2
    exit 0
fi

# When the formatter config itself changes, re-check the two invariants that
# caused the original drift: black and isort must wrap at the same width, and the
# container must actually have the versions requirements-dev.txt pins. A tree that
# is clean today silently rots if either of these slips.
if [ -n "$config" ]; then
    if ! docker exec -i -w /project "$CONTAINER" python - <<'CONFIGCHECK'
import sys, tomllib
from importlib.metadata import version
from pathlib import Path

problems = []
cfg = tomllib.loads(Path("pyproject.toml").read_text())
black_len = cfg["tool"]["black"]["line-length"]
isort_cfg = cfg["tool"]["isort"]

# profile="black" does NOT inherit black's line-length; it defaults to 88.
if "line_length" not in isort_cfg:
    problems.append("isort has no explicit line_length; the black profile defaults it to 88, not to black's setting")
elif isort_cfg["line_length"] != black_len:
    problems.append(f"black wraps at {black_len} but isort wraps at {isort_cfg['line_length']}")

pins = {}
for line in Path("requirements-dev.txt").read_text().splitlines():
    line = line.split("#", 1)[0].strip()
    if "==" in line:
        name, _, ver = line.partition("==")
        pins[name.strip().lower()] = ver.strip()

for tool in ("black", "isort"):
    if tool not in pins:
        problems.append(f"{tool} is not pinned with == in requirements-dev.txt")
    elif version(tool) != pins[tool]:
        problems.append(f"{tool} {version(tool)} installed but pinned {pins[tool]} — rebuild the image")

for p in problems:
    print(f"CONFIG {p}", file=sys.stderr)
sys.exit(1 if problems else 0)
CONFIGCHECK
    then
        printf '%s\n' "" \
            "Commit blocked: the formatter config is inconsistent." \
            "" \
            "This is the exact condition that made every format pass churn unrelated" \
            "files. Fix it before committing, and reformat the tree in its own commit." \
            "" >&2
        exit 1
    fi
fi

[ -z "$files" ] && exit 0

# shellcheck disable=SC2086  # deliberate word-split of the newline-separated list
unformatted=$(docker exec -i -w /project "$CONTAINER" sh -s -- $files <<'CHECK'
# Note the flags differ: black names its stdin file with --stdin-filename, isort
# with --filename. Getting one wrong is a usage error, not a format failure, and
# exits 2 — hence the exit-code split below, so a broken invocation announces
# itself instead of silently condemning every file.
for f in "$@"; do
    git show ":$f" | black --check --quiet --stdin-filename "$f" - >/dev/null 2>&1
    case $? in
    0) ;;
    1) printf 'black  %s\n' "$f" ;;
    *) printf 'ERROR  black could not check %s\n' "$f" ;;
    esac

    git show ":$f" | isort --check-only --quiet --filename "$f" - >/dev/null 2>&1
    case $? in
    0) ;;
    1) printf 'isort  %s\n' "$f" ;;
    *) printf 'ERROR  isort could not check %s\n' "$f" ;;
    esac
done
CHECK
)

[ -z "$unformatted" ] && exit 0

# Only the offending files go in the suggested command, space-joined so it stays
# a single runnable line.
bad=$(printf '%s\n' "$unformatted" | awk '{print $NF}' | sort -u | tr '\n' ' ')

printf '%s\n' "" \
    "Commit blocked: staged Python is not formatted." \
    "" \
    "$unformatted" \
    "" \
    "Fix and re-stage:" \
    "" \
    "  docker exec -w /project $CONTAINER sh -c 'black $bad && isort $bad'" \
    "  git add $bad" \
    "" \
    "Bypass with --no-verify only if you are deliberately committing unformatted code." \
    "" >&2

exit 1
